{
   "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
   "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
   },
   "files": {
      "ignoreUnknown": false
   },
   "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 3
   },
   "linter": {
      "rules": {
         "preset": "recommended",
         "a11y": {
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useMediaCaption": "off"
         },
         "complexity": {
            "noCommaOperator": "off"
         },
         "suspicious": {
            "noAssignInExpressions": "off",
            "noExplicitAny": "off",
            "useIterableCallbackReturn": "off",
            "noNonNullAssertedOptionalChain": "off"
         },
         "style": {
            "noNonNullAssertion": "off"
         }
      },
      "includes": ["**", "!docs/**"]
   },
   "javascript": {
      "formatter": {
         "quoteStyle": "double"
      }
   },
   "css": {
      "parser": {
         "tailwindDirectives": true
      }
   },
   "assist": {
      "enabled": true,
      "actions": {
         "source": {
            "organizeImports": "on"
         }
      }
   }
}
